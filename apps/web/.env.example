# Public Cognito User Pool values for eu-west-1. No client secret belongs in this file.
NEXT_PUBLIC_COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_REPLACE_ME
NEXT_PUBLIC_COGNITO_CLIENT_ID=REPLACE_WITH_PUBLIC_APP_CLIENT_ID
NEXT_PUBLIC_COGNITO_DOMAIN=https://REPLACE_WITH_COGNITO_DOMAIN.auth.eu-west-1.amazoncognito.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI base URL. The API must allow the exact frontend origin in CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
