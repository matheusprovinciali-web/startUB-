APP_ENV=development
AWS_REGION=eu-west-1
DATABASE_URL=postgresql://starub_api:CHANGE_ME@localhost:5432/starub

# Amazon Cognito User Pool in eu-west-1 (replace the User Pool and app-client placeholders).
# Issuer format: https://cognito-idp.eu-west-1.amazonaws.com/<user-pool-id>
AUTH_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_EXAMPLE
AUTH_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID
# Optional: configure only when using a Cognito resource-server audience claim.
AUTH_AUDIENCE=
AUTH_JWKS_URL=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_EXAMPLE/.well-known/jwks.json

CORS_ORIGINS=["http://localhost:3000"]
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
